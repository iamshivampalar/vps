<%- include('../layouts/header') %>

<section class="py-16 bg-slate-50 min-h-screen">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Back button navigational anchor -->
    <a href="/programs" class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 hover:text-[#0F172A] mb-8 select-none">
      <i class="bi bi-arrow-left"></i> Return to listings index
    </a>

    <!-- Main visual presentation card -->
    <div class="bg-white border border-slate-100 shadow-premium rounded-3xl p-8 lg:p-12">
      
      <!-- Upper Section -->
      <div class="flex flex-col gap-6 md:flex-row md:justify-between items-start border-b border-slate-100 pb-8 mb-8">
        <div class="flex flex-col gap-3">
          <span class="inline-block w-fit text-xs bg-blue-50 text-accent font-semibold border border-blue-100 uppercase tracking-widest px-3 py-1 rounded-full"><%= program.category %></span>
          <h1 class="text-2xl sm:text-4xl font-extrabold text-[#0F172A] tracking-tight font-poppins"><%= program.title %></h1>
          
          <div class="flex flex-wrap items-center gap-6 text-xs text-slate-500 mt-2 font-medium">
            <span><i class="bi bi-calendar3 text-[#3B82F6]"></i> Duration: <strong><%= program.duration %></strong></span>
            <span><i class="bi bi-person-workspace text-emerald-600"></i> Slots: <strong><%= program.seats %> Seats</strong></span>
            <span><i class="bi bi-patch-check text-amber-500"></i> Award: <strong><%= program.certificateAvailable ? 'Issuable Certificate' : 'Review only' %></strong></span>
          </div>
        </div>

        <div class="w-full md:w-auto">
          <% if (user) { %>
            <% if (user.role === 'Student') { %>
              <button id="applyBtn" onclick="submitApplication('<%= program.id %>')" class="w-full md:w-auto bg-themePrimary hover:bg-accent text-white font-bold text-sm px-8 py-3.5 rounded-xl shadow-premium transition-all">Submit Application Track</button>
            <% } else { %>
              <span class="block text-center text-xs text-slate-400 font-semibold bg-slate-100 px-4 py-3 rounded-xl border border-slate-200">Logged in as <%= user.role %></span>
            <% } %>
          <% } else { %>
            <a href="/auth/login?error=Please login as a student." class="block text-center bg-accent hover:bg-blue-600 text-white font-semibold text-sm px-8 py-3.5 rounded-xl shadow-sm transition-all">Login to Apply</a>
          <% } %>
        </div>
      </div>

      <!-- Core Description and metadata grids -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">
        
        <!-- Left description block -->
        <div class="md:col-span-2 flex flex-col gap-6">
          <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">Academic Description</h3>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed whitespace-pre-line"><%= program.description %></p>
          </div>
        </div>

        <!-- Right metadata checklist block -->
        <div class="bg-slate-50 border border-slate-100 rounded-2xl p-6 h-fit flex flex-col gap-6">
          
          <div>
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Academic Eligibility</h4>
            <div class="text-xs text-slate-600 font-medium leading-relaxed bg-white border border-slate-200/50 p-3 rounded-lg flex items-start gap-1.5">
              <i class="bi bi-info-circle-fill text-[#3B82F6]"></i> <%= program.eligibility %>
            </div>
          </div>

          <div>
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Subject Competencies</h4>
            <div class="flex flex-wrap gap-1.5">
              <% program.skills.split(',').forEach(sk => { %>
                <span class="text-[10px] bg-white border border-slate-200 text-slate-600 px-2.5 py-1 rounded-md font-semibold"><%= sk.trim() %></span>
              <% }) %>
            </div>
          </div>

          <div class="border-t border-slate-200/50 pt-4 text-xs text-slate-400 flex flex-col gap-2">
            <span class="flex items-center gap-1.5"><i class="bi bi-shield-check-fill text-gold"></i> Cryptgorphically verifiable</span>
            <span class="flex items-center gap-1.5"><i class="bi bi-person-check-fill text-emerald-600"></i> Mentorship review checks</span>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

<!-- Processing Script handles API interaction -->
<script>
  async function submitApplication(internshipId) {
    const btn = document.getElementById('applyBtn');
    if (!btn) return;
    
    // UI Loading state
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Submitting...';

    try {
      const response = await fetch('/student/apply', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ internshipId })
      });

      const resData = await response.json();

      if (response.ok) {
        // Success alert
        alert('Success! Your application was submitted. Review progress in your student console.');
        window.location.href = '/student/dashboard';
      } else {
        alert('Failed: ' + (resData.error || 'Unable to submit application at this time.'));
        btn.disabled = false;
        btn.innerHTML = 'Submit Application Track';
      }
    } catch (err) {
      console.error(err);
      alert('Internal Server Error connecting to registry endpoints.');
      btn.disabled = false;
      btn.innerHTML = 'Submit Application Track';
    }
  }
</script>

<%- include('../layouts/footer') %>
