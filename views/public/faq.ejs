<%- include('../layouts/header') %>

<section class="py-16 bg-slate-50 min-h-screen">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#0F172A] tracking-tight font-poppins">Frequently Asked Questions</h1>
      <p class="text-slate-500 mt-2">Answers about eligibility, secure certificate verification, and curriculum guidelines.</p>
    </div>

    <div class="space-y-4">
      <% if (items.length > 0) { %>
        <% items.forEach((faq, index) => { %>
          <div class="bg-white border border-slate-100 shadow-sm rounded-2xl overflow-hidden">
            <button class="w-full text-left px-6 py-4 font-bold text-slate-800 flex justify-between items-center focus:outline-none hover:bg-slate-50" type="button" data-bs-toggle="collapse" data-bs-target="#faq-<%= index %>">
              <span class="font-poppins text-sm md:text-base"><%= faq.q %></span>
              <i class="bi bi-chevron-down text-slate-400"></i>
            </button>
            <div id="faq-<%= index %>" class="collapse">
              <div class="px-6 pb-6 text-sm text-slate-500 leading-relaxed border-t border-slate-50 pt-4">
                <%= faq.a %>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-center text-slate-400">No FAQs compiled at this time.</p>
      <% } %>
    </div>

  </div>
</section>

<%- include('../layouts/footer') %>
