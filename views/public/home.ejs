<%- include('../layouts/header') %>

<!-- HERO SECTION: Premium SaaS Inspired Layout -->
<section class="relative overflow-hidden py-24 bg-gradient-to-b from-white via-slate-50 to-white">
  
  <!-- Floating decorative shapes -->
  <div class="absolute top-10 left-10 w-72 h-72 bg-blue-100 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse"></div>
  <div class="absolute bottom-10 right-10 w-96 h-96 bg-amber-100 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-pulse"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center flex flex-col items-center">
    
    <!-- Micro badge -->
    <span class="inline-flex items-center gap-1.5 px-3.5 py-1 mb-6 text-xs font-semibold text-accent rounded-full bg-blue-50 border border-blue-100/50 uppercase tracking-widest font-poppins">
      <span class="w-1.5 h-1.5 bg-accent rounded-full animate-ping"></span> Enterprise Grade Professional Internships
    </span>

    <!-- Hero Title -->
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-themePrimary tracking-tight font-poppins max-w-4xl leading-tight">
      <%= cmsData.heroTitle || 'Accelerate Your Career with Verifiable Internships' %>
    </h1>
    
    <!-- Subtitle -->
    <p class="mt-6 text-lg sm:text-xl text-slate-500 max-w-2xl leading-relaxed">
      <%= cmsData.heroSubtitle || 'Work on real corporate-sponsored initiatives, complete educational milestones under mentorship, and earn secure credentials trusted worldwide.' %>
    </p>

    <!-- Main CTA Buttons with micro-shadows -->
    <div class="mt-10 flex flex-wrap gap-4 justify-center">
      <a href="/programs" class="bg-themePrimary hover:bg-themeSecondary text-white text-base font-semibold px-8 py-4 rounded-xl shadow-premium hover:shadow-2xl flex items-center gap-2 premium-transition">
        Explore Fellowships <i class="bi bi-arrow-right-short text-xl"></i>
      </a>
      <a href="/verify" class="border border-slate-300 bg-white/50 hover:bg-white text-slate-700 text-base font-semibold px-8 py-4 rounded-xl shadow-sm flex items-center gap-2 transition-all">
        <i class="bi bi-patch-check-fill text-gold"></i> Verification Portal
      </a>
    </div>

    <!-- Live statistics dashboard row -->
    <div class="mt-20 grid grid-cols-1 sm:grid-cols-3 gap-8 w-full max-w-4xl border border-slate-100 bg-white/70 backdrop-blur shadow-premium rounded-2xl p-8 relative overflow-hidden">
      <!-- Diagonal grid border standard SaaS indicator -->
      <div class="text-center">
        <h3 class="text-3xl sm:text-4xl font-extrabold text-themePrimary font-poppins"><%= stats.studentsCount %>+</h3>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mt-1">Enrolled Fellows</p>
      </div>
      <div class="text-center sm:border-x border-slate-100 py-4 sm:py-0">
        <h3 class="text-3xl sm:text-4xl font-extrabold text-[#3B82F6] font-poppins"><%= stats.internshipsCount %></h3>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mt-1">Active Tech Tracks</p>
      </div>
      <div class="text-center">
        <h3 class="text-3xl sm:text-4xl font-extrabold text-gold font-poppins"><%= stats.certificatesCount %>+</h3>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mt-1">Secured Certificates</p>
      </div>
    </div>

  </div>
</section>

<!-- BRAND RECOGNITION: University Partners -->
<section class="py-12 bg-white border-y border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-center text-xs font-bold text-slate-400 uppercase tracking-wider mb-8">Allied University Partners & Training Collaborators</p>
    <div class="flex flex-wrap justify-center items-center gap-12 md:gap-20 opacity-60">
      <span class="text-lg font-bold text-slate-500 font-poppins tracking-wider flex items-center gap-1.5"><i class="bi bi-mortarboard-fill"></i> Stanford Engineering</span>
      <span class="text-lg font-bold text-slate-500 font-poppins tracking-wider flex items-center gap-1.5"><i class="bi bi-mortarboard-fill"></i> Princeton Academy</span>
      <span class="text-lg font-bold text-slate-500 font-poppins tracking-wider flex items-center gap-1.5"><i class="bi bi-mortarboard-fill"></i> MIT informatics</span>
    </div>
  </div>
</section>

<!-- SECTIONS: Features List -->
<section class="py-20 bg-slate-50/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-themePrimary tracking-tight font-poppins">Built Around Unified Academic Standards</h2>
      <p class="text-slate-500 mt-4 leading-relaxed">Our workspace reporting software operates without mock code, connecting universities, students, coordinators, and directors of internships directly.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% if (cmsData.features && cmsData.features.length) { %>
        <% cmsData.features.forEach((feat, k) => { %>
          <div class="bg-white border border-slate-100 hover:border-blue-100 hover:shadow-premium hover:-translate-y-1 rounded-2xl p-8 premium-transition shadow-sm flex flex-col gap-4">
            <span class="w-12 h-12 rounded-xl bg-blue-50 text-accent flex items-center justify-center text-xl font-bold font-poppins border border-blue-100/50">
              <%= k + 1 %>
            </span>
            <h3 class="text-lg font-bold text-themePrimary font-poppins"><%= feat.title %></h3>
            <p class="text-sm text-slate-500 leading-relaxed"><%= feat.desc %></p>
          </div>
        <% }) %>
      <% } else { %>
        <div class="bg-white border border-slate-100 p-8 rounded-2xl">
          <h3 class="text-lg font-bold text-themePrimary font-poppins">Dynamic Tracks</h3>
          <p class="text-sm text-slate-500">Live coursework syllabi, submission checkpoints, and review revisions.</p>
        </div>
      <% } %>
    </div>

  </div>
</section>

<!-- FEATURED LISTINGS BLOCK -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div>
        <h2 class="text-3xl font-extrabold text-themePrimary tracking-tight font-poppins">Explore Featured Fellowships</h2>
        <p class="text-slate-500 mt-2">Publish and request tracks. Get matched with leading mentor departments.</p>
      </div>
      <a href="/programs" class="text-sm font-semibold text-accent hover:text-blue-700 flex items-center gap-1 h-fit">
        Browse all programs <i class="bi bi-chevron-right"></i>
      </a>
    </div>

    <!-- Dynamic Item Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% featuredInternships.forEach(item => { %>
        <div class="bg-slate-50 border border-slate-100 hover:bg-white hover:border-[#3B82F6] hover:shadow-premium rounded-2xl p-6 flex flex-col gap-5 premium-transition">
          <div class="flex justify-between items-start gap-2">
            <span class="text-xs bg-slate-200 text-slate-700 px-3 py-1 rounded-full font-semibold uppercase tracking-wider"><%= item.category %></span>
            <span class="text-xs text-slate-400 font-medium font-mono border border-slate-200/50 px-2 py-0.5 rounded flex items-center gap-1"><i class="bi bi-clock"></i> <%= item.duration %></span>
          </div>
          <div>
            <h3 class="text-lg font-extrabold text-themePrimary tracking-tight font-poppins hover:text-accent transition-colors">
              <a href="/programs/<%= item.id %>"><%= item.title %></a>
            </h3>
            <p class="text-sm text-slate-500 mt-2 line-clamp-3 leading-relaxed"><%= item.description %></p>
          </div>
          <div class="border-t border-slate-200/50 pt-4 flex items-center justify-between mt-auto">
            <span class="text-xs font-semibold text-slate-500 uppercase"><i class="bi bi-people"></i> Seats: <strong class="text-slate-800"><%= item.seats %></strong></span>
            <a href="/programs/<%= item.id %>" class="bg-themePrimary text-white hover:bg-accent text-xs font-bold px-3 py-2 rounded-lg transition-colors flex items-center gap-1">
              Apply Track <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      <% }) %>
    </div>

  </div>
</section>

<!-- TESTIMONIALS SECTION -->
<section class="py-20 bg-[#0F172A] text-white overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl font-bold font-poppins">Success Stories From Fellows</h2>
      <p class="text-slate-400 mt-2">How InternSpace credentials help fellows transition into industry careers.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <% if (cmsData.testimonials && cmsData.testimonials.length) { %>
        <% cmsData.testimonials.forEach(test => { %>
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 flex flex-col gap-6 relative shadow-xl">
            <i class="bi bi-quote text-5xl text-[#3B82F6] opacity-30 absolute top-4 right-4"></i>
            <p class="text-slate-300 italic leading-relaxed text-sm">"<%= test.txt %>"</p>
            <div class="flex items-center gap-3 border-t border-slate-800 pt-4 mt-auto">
              <span class="w-10 h-10 rounded-full bg-slate-800 text-white flex items-center justify-center font-bold text-sm"><%= test.author.charAt(0) %></span>
              <div>
                <h4 class="text-sm font-bold text-white font-poppins"><%= test.author %></h4>
                <p class="text-xs text-slate-500"><%= test.role %></p>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="bg-slate-950 p-6 rounded-2xl">
          <p class="text-slate-400">Loading success stories...</p>
        </div>
      <% } %>
    </div>

  </div>
</section>

<!-- CTA INVITATION WRAPPER -->
<section class="py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 text-center border border-slate-100 bg-gradient-to-tr from-slate-50 via-white to-blue-50/20 rounded-3xl p-12 shadow-premium relative overflow-hidden flex flex-col items-center">
    <div class="absolute top-0 right-0 w-48 h-48 bg-accent/5 rounded-full filter blur-3xl"></div>
    <h2 class="text-3xl font-extrabold text-themePrimary tracking-tight font-poppins">Ready to Enroll Your Program?</h2>
    <p class="text-slate-500 mt-4 max-w-lg leading-relaxed">Whether you represent an academic department, NGO director, or a corporate partner - join the elite student workspace tracker network today.</p>
    <div class="mt-8 flex gap-4">
      <a href="/auth/register" class="bg-[#3B82F6] hover:bg-blue-600 text-white font-semibold text-sm px-6 py-3 rounded-xl shadow-premium transition-colors">Start Fellowship</a>
      <a href="/contact" class="border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-sm px-6 py-3 rounded-xl transition-colors">Contact Officers</a>
    </div>
  </div>
</section>

<%- include('../layouts/footer') %>
