<%- include('layouts/header') %>

<section class="py-24 bg-slate-50 min-h-[70vh] flex items-center">
  <div class="max-w-md mx-auto px-4 text-center">
    
    <div class="bg-white border border-slate-100 shadow-premium rounded-3xl p-8 flex flex-col items-center">
      <span class="w-16 h-16 bg-rose-50 text-rose-500 rounded-full flex items-center justify-center text-3xl border border-rose-100 mb-6"><i class="bi bi-shield-slash-fill"></i></span>
      <h1 class="text-2xl font-extrabold text-[#0F172A] tracking-tight font-poppins"><%= title %></h1>
      <p class="text-slate-500 text-sm mt-3 leading-relaxed mb-6"><%= message %></p>
      
      <div class="flex gap-3 w-full">
        <a href="/" class="w-full bg-themePrimary hover:bg-themeSecondary text-white text-xs font-semibold py-3 px-4 rounded-xl transition-colors">Go Home</a>
        <button onclick="window.history.back()" class="w-full border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold py-3 px-4 rounded-xl transition-all">Go Back</button>
      </div>
    </div>

  </div>
</section>

<%- include('layouts/footer') %>
