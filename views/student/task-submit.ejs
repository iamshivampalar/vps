<%- include('../layouts/header') %>

<div class="py-12 bg-slate-50 min-h-screen">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Quick return back -->
    <a href="/student/dashboard" class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 hover:text-slate-900 mb-8 select-none">
      <i class="bi bi-arrow-left"></i> Return to workspace console
    </a>

    <!-- MAIN EXERCISE CONTENT CARD -->
    <div class="bg-white border border-slate-100 shadow-premium rounded-3xl p-8 md:p-10 mb-8">
      
      <!-- Upper Section -->
      <div class="border-b border-slate-100 pb-5 mb-8">
        <span class="inline-block text-[10px] bg-blue-50 text-accent font-bold border border-blue-100 uppercase px-3 py-1 rounded-full mb-3 tracking-widest"><%= task.internship.title %></span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0F172A] tracking-tight font-poppins"><%= task.title %></h1>
        
        <div class="flex flex-wrap gap-6 text-xs text-slate-500 mt-3 font-semibold">
          <span><i class="bi bi-calendar-event"></i> Due Date Check: <strong><%= task.dueDate ? new Date(task.dueDate).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Flexible' %></strong></span>
          <span><i class="bi bi-award"></i> Scale Value: <strong class="text-slate-800"><%= task.maxPoints %> Grade Points</strong></span>
        </div>
      </div>

      <!-- Task description text representation -->
      <div class="mb-8">
        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">Homework Requirements</h3>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed whitespace-pre-line bg-slate-50 border border-slate-100 p-5 rounded-2xl"><%= task.description %></p>
      </div>

      <!-- TASK WORK SUBMISSION FORM -->
      <div class="border-t border-slate-100 pt-8">
        <h3 class="text-sm font-extrabold text-slate-800 font-poppins mb-4">Complete Work Submission</h3>
        
        <form id="submissionForm" onsubmit="submitTaskWork(event, '<%= task.id %>')" class="space-y-6">
          
          <!-- Notes text text-area -->
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-500 uppercase">Interactive Notes / URL Links</label>
            <textarea id="submissionText" required rows="5" placeholder="Include text responses, GitHub repositories, or Notion workspace URLs..." class="w-full px-4 py-3 border border-slate-200 focus:border-accent rounded-xl text-sm focus:outline-none"><%= submission ? submission.submissionText : '' %></textarea>
          </div>

          <!-- Upload PDF / Doc layout attachments -->
          <div class="flex flex-col gap-2">
            <label class="text-xs font-bold text-slate-550 uppercase">Work File Attachment (PDF, DOC, DOCX, PNG, JPG)</label>
            <% if (submission && submission.attachments) { %>
              <div class="bg-blue-50/50 border border-blue-200 rounded-xl p-4 flex items-center justify-between gap-4 mb-2">
                <div class="flex items-center gap-2">
                  <i class="bi bi-file-earmark-check-fill text-accent text-xl"></i>
                  <div>
                    <span class="text-xs font-bold text-slate-800 truncate block max-w-[200px]">Attached Work Document</span>
                    <a href="<%= submission.attachments %>" target="_blank" class="text-[10px] text-[#3B82F6] underline">Download submitted file</a>
                  </div>
                </div>
                <span class="text-[10px] text-slate-400 font-semibold uppercase">Overwriting allowed</span>
              </div>
            <% } %>
            <input type="file" id="attachments" class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-accent hover:file:bg-blue-100">
            <span class="text-[10px] text-slate-450 mt-1">Maximum upload size 10MB. Overwrites existing file on re-upload.</span>
          </div>

          <!-- Submission parameters status details -->
          <% if (submission) { %>
            <div class="bg-slate-50 border border-slate-150 rounded-2xl p-4 flex flex-col gap-3">
              <div class="flex items-center justify-between text-xs border-b border-white pb-3">
                <span class="text-slate-400">Current Review State:</span>
                <% if (submission.status === 'Approved') { %>
                  <span class="text-xs bg-emerald-50 text-emerald-700 font-bold px-3 py-0.5 rounded border border-emerald-100 uppercase tracking-wide">Approved (<%= submission.grade %>/100 pts)</span>
                <% } else if (submission.status === 'Revision Requested') { %>
                  <span class="text-xs bg-amber-50 text-amber-700 font-bold px-3 py-0.5 rounded border border-amber-100 uppercase tracking-wide">Revision Required</span>
                <% } else if (submission.status === 'Rejected') { %>
                  <span class="text-xs bg-rose-50 text-rose-700 font-bold px-3 py-0.5 rounded border border-rose-100 uppercase tracking-wide">Work Rejected</span>
                <% } else { %>
                  <span class="text-xs bg-blue-50 text-accent font-bold px-3 py-0.5 rounded border border-blue-100 uppercase tracking-wide">Awaiting Appraisal Review</span>
                <% } %>
              </div>
              <% if (submission.feedback) { %>
                <div class="text-xs">
                  <span class="block font-bold text-slate-700 mb-1">Supervisor appraisal feedback remarks:</span>
                  <p class="text-slate-500 italic"><%= submission.feedback %></p>
                </div>
              <% } %>
            </div>
          <% } %>

          <!-- Submission action triggers -->
          <div class="pt-4">
            <% if (submission && submission.status === 'Approved') { %>
              <button type="button" disabled class="w-full bg-slate-300 text-slate-500 font-extrabold py-3.5 px-4 rounded-xl cursor-not-allowed">Assignment is Already Approved & Locked</button>
            <% } else { %>
              <button type="submit" id="submitBtn" class="w-full bg-themePrimary hover:bg-[#3B82F6] text-white font-bold py-3.5 px-4 rounded-xl shadow-premium transition-colors">Commit Task Work Upload</button>
            <% } %>
          </div>

        </form>

      </div>

    </div>

  </div>
</div>

<script>
  async function submitTaskWork(event, taskId) {
    event.preventDefault();
    const btn = document.getElementById('submitBtn');
    if (!btn) return;

    btn.disabled = true;
    btn.innerHTML = 'Uploading files...';

    const formData = new FormData();
    formData.append('submissionText', document.getElementById('submissionText').value);
    
    const fileInput = document.getElementById('attachments');
    if (fileInput && fileInput.files.length > 0) {
      formData.append('attachments', fileInput.files[0]);
    }

    try {
      const response = await fetch(`/student/tasks/${taskId}/submit`, {
        method: 'POST',
        body: formData
      });

      const resData = await response.json();

      if (response.ok) {
        alert('Hurrah! Your homework task is submitted. Recheck progress on dashboard.');
        window.location.href = '/student/dashboard';
      } else {
        alert('Submission failed: ' + (resData.error || 'Check files or network.'));
        btn.disabled = false;
        btn.innerHTML = 'Commit Task Work Upload';
      }
    } catch (err) {
       console.error(err);
       alert('Failed uploading work to administrative endpoint.');
       btn.disabled = false;
       btn.innerHTML = 'Commit Task Work Upload';
    }
  }
</script>

<%- include('../layouts/footer') %>
