<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= siteTitle %></title>
  
  <!-- CSS Framework CDNs -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Icons Support -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Fonts Setup -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind Compiler Customization -->
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            themePrimary: '#0F172A',
            themeSecondary: '#1E293B',
            accent: '#3B82F6',
            success: '#22C55E',
            warning: '#F59E0B',
            danger: '#EF4444',
            gold: '#C9A227',
            premiumGold: '#FFD700',
            darkBG: '#020617'
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            poppins: ['Poppins', 'sans-serif']
          },
          boxShadow: {
            'premium': '0 4px 20px -2px rgba(15, 23, 42, 0.08)',
            'glowing': '0 0 20px -2px rgba(59, 130, 246, 0.15)'
          }
        }
      }
    };
  </script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #FFFFFF;
      color: #1F2937;
    }
    .font-poppins {
      font-family: 'Poppins', sans-serif;
    }
    .glassmorphism {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .premium-transition {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
  </style>
</head>
<body class="bg-[#F8FAFC]">

  <% 
    // Detect whether to render the dashboard sidebar and management frame
    const isManagementPage = (typeof user !== 'undefined' && user !== null) && 
      !['Premium', 'Our Mission', 'Available', 'Connect', 'Digital Credential', 'Privacy', 'Terms', 'Frequently', 'Error', 'Not Found'].some(term => title.includes(term)); 
  %>

  <!-- Mobile Drawer Sidebar overlay -->
  <% if (isManagementPage) { %>
    <div id="mobile-sidebar" class="fixed inset-0 z-50 hidden">
      <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="toggleMobileSidebar()"></div>
      <aside class="fixed top-0 bottom-0 left-0 w-64 bg-[#0F172A] text-slate-300 flex flex-col border-r border-slate-800">
        <!-- Logo Header -->
        <div class="p-6 flex items-center gap-3 border-b border-slate-850">
          <div class="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center shadow-lg shadow-blue-500/20">
            <i class="bi bi-rocket-takeoff-fill text-white text-sm"></i>
          </div>
          <span class="text-white font-extrabold text-lg tracking-tight font-poppins">InternSpace</span>
        </div>
        
        <!-- Navigation Lists -->
        <nav class="flex-1 px-4 space-y-1.5 mt-6 text-xs">
          <% if (user.role === 'Admin') { %>
            <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Command Control Center' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-355' %>">
              <i class="bi bi-grid-fill"></i>
              <span>Dashboard</span>
            </a>
            <a href="/admin/internships" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Publish Internship Tracks' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-355' %>">
              <i class="bi bi-briefcase-fill"></i>
              <span>Tracks</span>
            </a>
            <a href="/admin/students" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Student Fellowship roster' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-355' %>">
              <i class="bi bi-people-fill"></i>
              <span>Students</span>
            </a>
            <a href="/admin/tasks" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Curriculum Tasks' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-355' %>">
              <i class="bi bi-journal-check"></i>
              <span>Curriculum Tasks</span>
            </a>
            <a href="/admin/applications" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Review Candidate Applications' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-355' %>">
              <i class="bi bi-file-earmark-person-fill"></i>
              <span>Admissions</span>
            </a>
            <a href="/admin/submissions" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Assign Assignment Grades' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-355' %>">
              <i class="bi bi-card-checklist"></i>
              <span>Appraisal Queue</span>
            </a>
            <a href="/admin/colleges" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title.includes('Universities') ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-355' %>">
              <i class="bi bi-bank2"></i>
              <span>Universities</span>
            </a>
            <a href="/admin/settings" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title.includes('Configurations') ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-355' %>">
              <i class="bi bi-gear-fill"></i>
              <span>Settings Configuration</span>
            </a>
          <% } else if (user.role === 'Student') { %>
            <a href="/student/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Candidate Learning Dashboard' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-355' %>">
              <i class="bi bi-grid-fill"></i>
              <span>My Workspace</span>
            </a>
            <a href="/student/profile" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Build Credentials Profile' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-355' %>">
              <i class="bi bi-person-badge-fill"></i>
              <span>Cert Profile</span>
            </a>
            <a href="/programs" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold hover:bg-slate-800/40 hover:text-white text-slate-355">
               <i class="bi bi-search"></i>
               <span>Explore Tracks</span>
            </a>
          <% } %>
        </nav>

        <div class="p-4 border-t border-slate-850">
          <a href="/auth/logout" class="block text-center bg-slate-800 hover:bg-rose-950 text-white rounded-xl text-xs font-semibold py-2.5 transition-all">
            Logout Session
          </a>
        </div>
      </aside>
    </div>
  <% } %>

  <script>
    function toggleMobileSidebar() {
      const sidebar = document.getElementById('mobile-sidebar');
      if (sidebar) {
        sidebar.classList.toggle('hidden');
      }
    }
  </script>

  <!-- Main Navigation Navbar -->
  <% if (!isManagementPage) { %>
  <nav class="glassmorphism sticky top-0 z-50 border-b border-slate-100 bg-white/90 shadow-sm transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 text-xl font-extrabold text-themePrimary tracking-tight font-poppins">
          <span class="bg-[#0F172A] p-1.5 rounded-lg text-white flex items-center justify-center.5"><i class="bi bi-rocket-takeoff-fill text-accent"></i></span>
          <span class="bg-gradient-to-r from-themePrimary to-accent text-transparent bg-clip-text flex items-center gap-1.5">
            InternSpace
          </span>
          <span class="text-xs bg-gold/10 text-gold px-2 py-0.5 rounded-full border border-gold/10 font-medium">ELITE</span>
        </a>

        <!-- Desktop Menu Options -->
        <div class="hidden md:flex items-center gap-8">
          <a href="/" class="text-sm font-medium text-slate-600 hover:text-themePrimary transition-colors">Home</a>
          <a href="/programs" class="text-sm font-medium text-slate-600 hover:text-themePrimary transition-colors">Programs</a>
          <a href="/about" class="text-sm font-medium text-slate-600 hover:text-themePrimary transition-colors">Impact & About</a>
          <a href="/faq" class="text-sm font-medium text-slate-600 hover:text-themePrimary transition-colors">FAQ</a>
          <a href="/contact" class="text-sm font-medium text-slate-600 hover:text-themePrimary transition-colors">Contact</a>
          <a href="/verify" class="text-sm font-medium text-slate-600 hover:text-themePrimary text-accent flex items-center gap-1.5 transition-colors">
            <i class="bi bi-patch-check-fill text-gold"></i> Verification
          </a>
        </div>

        <!-- Auth CTA Actions -->
        <div class="hidden md:flex items-center gap-4">
          <% if (user) { %>
            <div class="flex items-center gap-4">
              <span class="text-xs text-slate-500 font-medium hidden lg:inline">Logged in as <strong class="text-slate-800"><%= user.name %></strong></span>
              <a href="<%= user.role === 'Student' ? '/student/dashboard' : '/admin/dashboard' %>" class="bg-themePrimary hover:bg-themeSecondary text-white text-xs font-semibold px-4 py-2 rounded-lg shadow-premium flex items-center gap-1.5 transition-all">
                <i class="bi bi-cpu"></i> Dashboard Panel
              </a>
              <a href="/auth/logout" class="border border-slate-200 hover:bg-slate-50 text-slate-600 text-xs font-semibold px-3 py-2 rounded-lg transition-all">
                Logout
              </a>
            </div>
          <% } else { %>
            <a href="/auth/login" class="text-sm font-semibold text-slate-600 hover:text-themePrimary transition-colors">Sign In</a>
            <a href="/auth/register" class="bg-themePrimary hover:bg-themeSecondary text-white text-sm font-semibold px-4 py-2.5 rounded-lg shadow-premium flex items-center gap-1 transition-all">
              Initialize Account <i class="bi bi-arrow-right"></i>
            </a>
          <% } %>
        </div>

        <!-- Mobile Menu Triggers -->
        <div class="md:hidden flex items-center">
          <button type="button" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')" class="text-slate-600 focus:outline-none">
            <i class="bi bi-list text-2xl"></i>
          </button>
        </div>

      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-slate-100 flex flex-col px-4 py-2 gap-3 pb-4">
      <a href="/" class="text-sm font-medium text-slate-600 py-1">Home</a>
      <a href="/programs" class="text-sm font-medium text-slate-600 py-1">Programs</a>
      <a href="/about" class="text-sm font-medium text-slate-600 py-1">About</a>
      <a href="/faq" class="text-sm font-medium text-slate-600 py-1">FAQ</a>
      <a href="/contact" class="text-sm font-medium text-slate-600 py-1">Contact</a>
      <a href="/verify" class="text-sm font-medium text-slate-600 py-1 text-accent flex items-center gap-1">
        <i class="bi bi-patch-check-fill text-gold"></i> Verification Portal
      </a>
      <div class="border-t border-slate-100 pt-3 flex flex-col gap-2">
        <% if (user) { %>
          <a href="<%= user.role === 'Student' ? '/student/dashboard' : '/admin/dashboard' %>" class="bg-themePrimary text-white text-center text-xs font-semibold py-2.5 rounded-lg">
            Dashboard Panel
          </a>
          <a href="/auth/logout" class="border border-slate-200 text-center text-xs font-semibold py-2 rounded-lg">
            Logout
          </a>
        <% } else { %>
          <a href="/auth/login" class="text-center text-sm font-semibold text-slate-600 py-1.5">Sign In</a>
          <a href="/auth/register" class="bg-themePrimary text-white text-center text-sm font-semibold py-2.5 rounded-lg">
            Initialize Account
          </a>
        <% } %>
      </div>
    </div>
  </nav>
  <% } %>

  <% if (isManagementPage) { %>
    <!-- Desktop Side-by-side Layout Wrapper -->
    <div class="flex h-screen w-screen bg-[#F8FAFC] overflow-hidden">
      
      <!-- Desktop Sidebar -->
      <aside class="w-64 bg-[#0F172A] text-slate-305 hidden md:flex flex-col border-r border-slate-800 shrink-0 select-none">
        <!-- Logo Header -->
        <div class="p-6 flex items-center gap-2.5 border-b border-slate-800/80">
          <div class="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center shadow-lg shadow-blue-500/20">
            <i class="bi bi-rocket-takeoff-fill text-white text-sm"></i>
          </div>
          <span class="text-white font-extrabold text-base tracking-tight font-poppins">InternSpace</span>
          <span class="text-[9px] bg-blue-500/10 text-blue-400 font-semibold px-1.5 py-0.5 rounded border border-blue-500/20">CONSOLE</span>
        </div>
        
        <!-- Navigation Link lists -->
        <nav class="flex-1 px-4 space-y-1 mt-6 text-xs">
          <% if (user.role === 'Admin') { %>
            <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Command Control Center' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-400' %>">
              <i class="bi bi-grid-fill"></i>
              <span>Dashboard</span>
            </a>
            <a href="/admin/internships" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Publish Internship Tracks' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-400' %>">
              <i class="bi bi-briefcase-fill"></i>
              <span>Tracks & Courses</span>
            </a>
            <a href="/admin/students" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Student Fellowship roster' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-400' %>">
              <i class="bi bi-people-fill"></i>
              <span>Students Roster</span>
            </a>
            <a href="/admin/tasks" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Curriculum Tasks' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-400' %>">
              <i class="bi bi-journal-check"></i>
              <span>Curriculum Tasks</span>
            </a>
            <a href="/admin/applications" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Review Candidate Applications' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-400' %>">
              <i class="bi bi-file-earmark-person-fill"></i>
              <span>Admissions</span>
            </a>
            <a href="/admin/submissions" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Assign Assignment Grades' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-400' %>">
              <i class="bi bi-card-checklist"></i>
              <span>Appraisal Queue</span>
            </a>
            <a href="/admin/colleges" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title.includes('Universities') ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-400' %>">
              <i class="bi bi-bank2"></i>
              <span>Allied Universities</span>
            </a>
            <a href="/admin/settings" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title.includes('Configurations') ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-400' %>">
              <i class="bi bi-gear-fill"></i>
              <span>Console Settings</span>
            </a>
          <% } else if (user.role === 'Student') { %>
            <a href="/student/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Candidate Learning Dashboard' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-400' %>">
              <i class="bi bi-grid-fill"></i>
              <span>My Workspace</span>
            </a>
            <a href="/student/profile" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold <%= title === 'Build Credentials Profile' ? 'bg-[#1E293B] text-white' : 'hover:bg-slate-800/40 hover:text-white text-slate-400' %>">
              <i class="bi bi-person-badge-fill"></i>
              <span>My Credentials</span>
            </a>
            <a href="/programs" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all font-semibold hover:bg-slate-800/40 hover:text-white text-slate-400">
               <i class="bi bi-search"></i>
               <span>Explore Tracks</span>
            </a>
          <% } %>
        </nav>

        <!-- User profile area bottom of sidebar -->
        <div class="p-4 border-t border-slate-800/60 mt-auto">
          <div class="bg-[#1E293B] rounded-xl p-3.5 flex flex-col gap-2.5">
            <div class="flex items-center gap-2.5 min-w-0">
              <div class="w-8 h-8 rounded-full bg-blue-600 text-white font-extrabold flex items-center justify-center text-xs shrink-0">
                <%= user.name.charAt(0) %>
              </div>
              <div class="flex flex-col min-w-0">
                <span class="text-xs font-bold text-white truncate"><%= user.name %></span>
                <span class="text-[10px] text-slate-400 truncate"><%= user.role %></span>
              </div>
            </div>
            <a href="/auth/logout" class="text-center bg-slate-800 hover:bg-rose-950 hover:text-rose-200 border border-slate-700/60 rounded-lg text-[10px] font-bold py-1.5 transition-colors text-slate-300">
              <i class="bi bi-box-arrow-right"></i> Log out
            </a>
          </div>
        </div>
      </aside>

      <!-- Main Panel Wrapper -->
      <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        
        <!-- Header bar inside Dashboard -->
        <header class="h-16 bg-white border-b border-slate-205 flex items-center justify-between px-6 md:px-8 shrink-0">
          <div class="flex items-center gap-3">
             <button onclick="toggleMobileSidebar()" class="md:hidden text-slate-700 flex items-center justify-center p-2 rounded-lg bg-slate-50 border border-slate-100 hover:bg-slate-100"><i class="bi bi-list text-xl"></i></button>
             <h2 class="text-xs font-bold text-slate-900 flex items-center gap-2">
               <span class="w-2 h-2 rounded-full bg-emerald-500 block animate-pulse"></span>
               Logged in as <%= user.name %> (<%= user.role %>)
             </h2>
          </div>
          <div class="flex items-center gap-4 text-xs font-medium">
             <a href="/" class="text-[11px] font-bold text-accent hover:underline flex items-center gap-1.5">
               <i class="bi bi-house-door-fill"></i> Public Home
             </a>
             <div class="h-4 w-[1px] bg-slate-200"></div>
             <a href="/verify" class="text-[11px] font-bold text-slate-500 hover:text-slate-750 flex items-center gap-1">
               <i class="bi bi-patch-check-fill text-gold"></i> Verification
             </a>
          </div>
        </header>

        <!-- Inner Content Area (Scrollable container) -->
        <div class="flex-1 overflow-y-auto">
  <% } %>

  <!-- Success/Error Global Toasts notifications -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
    <% if (successMsg) { %>
      <div class="bg-emerald-50 border border-emerald-100 text-emerald-800 text-sm py-3 px-4 rounded-xl flex items-center gap-2 mb-4 animate-fade-in shadow-premium">
        <i class="bi bi-check-circle-fill text-emerald-600"></i>
        <span><%= successMsg %></span>
      </div>
    <% } %>
    <% if (errorMsg) { %>
      <div class="bg-rose-50 border border-rose-100 text-rose-800 text-sm py-3 px-4 rounded-xl flex items-center gap-2 mb-4 animate-fade-in shadow-premium">
        <i class="bi bi-exclamation-triangle-fill text-rose-600"></i>
        <span><%= errorMsg %></span>
      </div>
    <% } %>
  </div>
