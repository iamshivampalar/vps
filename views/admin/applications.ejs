<%- include('../layouts/header') %>

<div class="py-10 bg-slate-50 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- COCKPIT CONTROL HEADER -->
    <div class="mb-8 border-b border-slate-200 pb-6">
      <h1 class="text-2xl font-extrabold text-[#0F172A] tracking-tight font-poppins"><i class="bi bi-person-check-fill text-accent"></i> Fellowship Intake Registrants</h1>
      <p class="text-xs text-slate-500 mt-1">Accept or decline candidate registrations into specific corporate-allied programs.</p>
    </div>

    <!-- MAIN APPLICATIONS DIRECTORY TABLE -->
    <div class="bg-white border border-slate-100 shadow-premium rounded-2xl overflow-hidden">
      <table class="table-auto w-full text-left text-xs">
        
        <thead>
          <tr class="bg-slate-100/50 border-b border-slate-105 text-[10px] font-extrabold uppercase text-slate-450 tracking-wider">
            <th class="px-6 py-4">Applied Scholar</th>
            <th class="px-6 py-4">Requested Fellowship Program</th>
            <th class="px-6 py-4">Current Intake Status</th>
            <th class="px-6 py-4">Administrative Feedback / Notes</th>
            <th class="px-6 py-4 text-right">Verification Decisions</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-100">
          <% if (applications.length > 0) { %>
            <% applications.forEach(app => { %>
              <tr class="hover:bg-slate-50/20 transition-colors">
                
                <td class="px-6 py-4">
                  <h4 class="font-bold text-slate-800 text-sm"><%= app.student.user.name %></h4>
                  <p class="text-[10px] text-slate-400 mt-0.5"><%= app.student.college?.name || 'Self-Sponsored' %> | <%= app.student.degree %></p>
                </td>

                <td class="px-6 py-4">
                  <p class="font-semibold text-slate-700 text-sm"><%= app.internship.title %></p>
                  <p class="text-[10px] text-slate-400">Duration: <%= app.internship.duration %> • Status: <%= app.internship.status %></p>
                </td>

                <td class="px-6 py-4">
                  <% if (app.status === 'Approved') { %>
                    <span class="text-[9px] bg-emerald-50 text-emerald-700 font-bold px-2 py-0.5 rounded border border-emerald-100 uppercase tracking-widest">Approved</span>
                  <% } else if (app.status === 'Rejected') { %>
                    <span class="text-[9px] bg-rose-50 text-rose-700 font-bold px-2 py-0.5 rounded border border-rose-100 uppercase tracking-widest">Rejected</span>
                  <% } else if (app.status === 'Completed') { %>
                    <span class="text-[9px] bg-[#0F172A] text-white font-bold px-2.5 py-0.5 rounded uppercase tracking-wider flex items-center gap-1 w-fit"><i class="bi bi-patch-check-fill text-gold"></i> Complete</span>
                  <% } else { %>
                    <span class="text-[9px] bg-amber-50 text-amber-700 font-bold px-2 py-0.5 rounded border border-amber-100 uppercase tracking-widest">Awaiting Decision</span>
                  <% } %>
                </td>

                <td class="px-6 py-4 max-w-xs truncate">
                  <span class="text-slate-500 font-medium italic"><%= app.adminNotes || 'None issued yet.' %></span>
                </td>

                <td class="px-6 py-4 text-right">
                  <div class="flex justify-end gap-2">
                    <% if (app.status === 'Pending') { %>
                      <button onclick="openDecisionModal('<%= app.id %>', 'Approved')" class="bg-emerald-50 hover:bg-emerald-100/80 text-emerald-700 font-bold px-3 py-1.5 rounded-lg text-[10px] leading-snug">Approve</button>
                      <button onclick="openDecisionModal('<%= app.id %>', 'Rejected')" class="bg-rose-50 hover:bg-rose-100/80 text-rose-705 font-bold px-3 py-1.5 rounded-lg text-[10px] leading-snug">Reject</button>
                    <% } else { %>
                      <button onclick="openDecisionModal('<%= app.id %>', '<%= app.status %>')" class="border border-slate-200 hover:bg-slate-50 text-slate-500 font-bold px-3 py-1.5 rounded-lg text-[10px] leading-snug">Update notes</button>
                    <% } %>
                  </div>
                </td>

              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="5" class="text-center py-8 text-slate-400">No student enrollment applications logged in records.</td></tr>
          <% } %>
        </tbody>

      </table>
    </div>

  </div>
</div>

<!-- DISSOLVABLE DECISION NOTES POPUP -->
<div id="decisionModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl w-full max-w-md shadow-2xl p-6 border border-slate-100 animate-fade-in">
    
    <div class="border-b border-slate-100 pb-3 mb-5 flex justify-between items-center">
      <h3 class="font-extrabold text-[#0F172A] text-base font-poppins">Admission Decision & Remarks</h3>
      <button onclick="document.getElementById('decisionModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600"><i class="bi bi-x-lg"></i></button>
    </div>

    <form id="decisionForm" onsubmit="submitDecision(event)" class="space-y-4">
      <input type="hidden" id="appId">
      <input type="hidden" id="appStatus">

      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-bold text-slate-500 uppercase">Decision Notification Status</label>
        <div id="statusBadge" class="text-xs font-bold font-poppins capitalize"></div>
      </div>

      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-bold text-slate-500 uppercase">Supervisor appraisal remarks / custom feedback</label>
        <textarea id="adminNotes" required rows="4" placeholder="Mention cohort code, representative guidelines, or rejection reason statement..." class="w-full px-3 py-2 border border-slate-200 focus:border-accent rounded-lg text-xs focus:outline-none"></textarea>
      </div>

      <button type="submit" id="submitBtn" class="w-full bg-[#0F172A] text-white font-bold py-2.5 rounded-lg text-xs mt-3 shadow-premium transition-colors">Commit decisions</button>

    </form>
  </div>
</div>

<script>
  let currentAppId = '';
  let currentStatus = '';

  function openDecisionModal(id, status) {
    currentAppId = id;
    currentStatus = status;

    document.getElementById('appId').value = id;
    document.getElementById('appStatus').value = status;
    
    const badge = document.getElementById('statusBadge');
    badge.innerText = status;
    if (status === 'Approved') {
      badge.className = 'text-xs font-extrabold text-emerald-600 font-poppins';
    } else if (status === 'Rejected') {
      badge.className = 'text-xs font-extrabold text-rose-500 font-poppins';
    } else {
      badge.className = 'text-xs font-extrabold text-slate-600 font-poppins';
    }

    document.getElementById('decisionModal').classList.remove('hidden');
  }

  async function submitDecision(event) {
    event.preventDefault();
    const btn = document.getElementById('submitBtn');
    if (!btn) return;

    btn.disabled = true;
    btn.innerHTML = 'Updating remarks...';

    const payload = {
      applicationId: currentAppId,
      status: currentStatus,
      adminNotes: document.getElementById('adminNotes').value
    };

    try {
      const response = await fetch('/admin/applications/evaluate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (response.ok) {
        window.location.reload();
      } else {
        const d = await response.json();
        alert('Action failed: ' + (d.error || 'Server error eval.'));
        btn.disabled = false;
        btn.innerHTML = 'Commit decisions';
      }
    } catch (e) {
      console.error(e);
      alert('Internal Server Error evaluating applicant.');
      btn.disabled = false;
      btn.innerHTML = 'Commit decisions';
    }
  }
</script>

<%- include('../layouts/footer') %>
