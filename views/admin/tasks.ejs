<%- include('../layouts/header') %>

<div class="py-10 bg-slate-50 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- COCKPIT CONTROL HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 border-b border-slate-200 pb-6">
      <div>
        <h1 class="text-2xl font-extrabold text-[#0F172A] tracking-tight font-poppins"><i class="bi bi-journal-check text-accent"></i> Academic Coursework & Milestones</h1>
        <p class="text-xs text-slate-500 mt-1">Add task deliverables, configure grade point scales, or set final due dates.</p>
      </div>
      <div>
        <button onclick="document.getElementById('addTaskModal').classList.toggle('hidden')" class="bg-[#3B82F6] hover:bg-blue-600 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow-premium flex items-center gap-1 leading-snug"><i class="bi bi-plus-lg"></i> Launch Task Checkpoint</button>
      </div>
    </div>

    <!-- EXPEDITIVE ADD TASK MODAL POPUP -->
    <div id="addTaskModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 flex items-center justify-center p-4">
      <div class="bg-white rounded-3xl w-full max-w-lg shadow-2xl p-6 border border-slate-100 animate-fade-in">
        
        <div class="border-b border-slate-100 pb-3 mb-5 flex justify-between items-center">
          <h3 class="font-extrabold text-[#0F172A] text-base font-poppins">Launch Task Deliverable</h3>
          <button onclick="document.getElementById('addTaskModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600"><i class="bi bi-x-lg"></i></button>
        </div>

        <form id="addTaskForm" onsubmit="submitNewTask(event)" class="space-y-4">
          
          <!-- Select associated internship -->
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-500 uppercase">Target Fellowship Track</label>
            <select id="internshipId" required class="w-full px-3 py-2 border border-slate-200 focus:border-accent rounded-lg text-xs focus:outline-none">
              <option value="">-- Choose Track --</option>
              <% internships.forEach(ins => { %>
                <option value="<%= ins.id %>"><%= ins.title %> (<%= ins.category %>)</option>
              <% }) %>
            </select>
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-500 uppercase">Task Title</label>
            <input type="text" id="taskTitle" required placeholder="e.g. Milestone 1: Initialize Express.js Server" class="w-full px-3 py-2 border border-slate-200 focus:border-accent rounded-lg text-xs focus:outline-none">
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-500 uppercase">Task Requirements / Briefing</label>
            <textarea id="taskDescription" required rows="4" placeholder="Mention guidelines, due formats, assets expected..." class="w-full px-3 py-2 border border-slate-200 focus:border-accent rounded-lg text-xs focus:outline-none"></textarea>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
               <label class="text-xs font-bold text-slate-500 uppercase">Due Date</label>
               <input type="date" id="dueDate" required class="w-full px-3 py-2 border border-slate-200 focus:border-accent rounded-lg text-xs focus:outline-none">
            </div>
            <div class="flex flex-col gap-1.5">
               <label class="text-xs font-bold text-slate-500 uppercase">Maximum Grade Points</label>
               <input type="number" id="maxPoints" value="100" required placeholder="100" class="w-full px-3 py-2 border border-slate-200 focus:border-accent rounded-lg text-xs focus:outline-none">
            </div>
          </div>

          <button type="submit" id="submitBtn" class="w-full bg-[#0F172A] text-white font-bold py-2.5 rounded-lg text-xs mt-3 shadow-premium transition-colors">Launch Task Checkpoint</button>

        </form>
      </div>
    </div>

    <!-- LIVE COURSEWORK CHECKS INDEX TABLE -->
    <div class="bg-white border border-slate-100 shadow-premium rounded-2xl overflow-hidden mt-6">
      <table class="table-auto w-full text-left text-xs">
        <thead>
          <tr class="bg-slate-100/50 border-b border-slate-105 text-[10px] font-extrabold uppercase text-slate-450 tracking-wider">
            <th class="px-6 py-4">Task Deliverable specifications</th>
            <th class="px-6 py-4">Assigned Program Category</th>
            <th class="px-6 py-4">Maximum points scale</th>
            <th class="px-6 py-4 text-right">Deadline date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (tasks.length > 0) { %>
            <% tasks.forEach(task => { %>
              <tr class="hover:bg-slate-50/20 transition-colors">
                <td class="px-6 py-4">
                  <h4 class="font-bold text-slate-800 text-sm"><%= task.title %></h4>
                  <p class="text-[10px] text-slate-400 mt-0.5 max-w-sm truncate"><%= task.description %></p>
                </td>
                <td class="px-6 py-4 font-semibold text-accent"><%= task.internship.title %></td>
                <td class="px-6 py-4 font-mono font-extrabold text-slate-655"><%= task.maxPoints %> pts</td>
                <td class="px-6 py-4 text-right font-mono font-medium text-slate-500">
                  <%= task.dueDate ? new Date(task.dueDate).toLocaleDateString([], { day: 'numeric', month: 'short', year: 'numeric' }) : 'Flexible' %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="4" class="text-center py-8 text-slate-400">No coursework milestones launched yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>
</div>

<script>
  async function submitNewTask(event) {
    event.preventDefault();
    const btn = document.getElementById('submitBtn');
    if (!btn) return;

    btn.disabled = true;
    btn.innerHTML = 'Publishing...';

    const payload = {
      internshipId: document.getElementById('internshipId').value,
      title: document.getElementById('taskTitle').value,
      description: document.getElementById('taskDescription').value,
      dueDate: document.getElementById('dueDate').value,
      maxPoints: document.getElementById('maxPoints').value
    };

    try {
      const response = await fetch('/admin/tasks/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (response.ok) {
        window.location.reload();
      } else {
        const data = await response.json();
        alert('Err: ' + (data.error || 'Failed to publish deliverable.'));
        btn.disabled = false;
        btn.innerHTML = 'Launch Task Checkpoint';
      }
    } catch (e) {
      console.error(e);
      alert('Internal Server Error syncing homework checkpoints.');
      btn.disabled = false;
      btn.innerHTML = 'Launch Task Checkpoint';
    }
  }
</script>

<%- include('../layouts/footer') %>
